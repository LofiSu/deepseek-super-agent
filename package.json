{
  "name": "ds-agent",
  "version": "0.1.0",
  "description": "Independent MIT super-agent: thin harness plus a proactive engine. Not an official DeepSeek product.",
  "license": "MIT",
  "author": "LofiSu <163713803+LofiSu@users.noreply.github.com>",
  "type": "module",
  "bin": {
    "ds-agent": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/MODULES.md",
    "docs/REAL_CHANNELS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "prepack": "pnpm build",
    "demo": "NODE_NO_WARNINGS=1 tsx src/cli/demos/run.ts",
    "demo:local": "NODE_NO_WARNINGS=1 tsx src/cli/demo.ts",
    "demo:feishu": "NODE_NO_WARNINGS=1 tsx src/cli/demos/feishu-smoke.ts",
    "test": "NODE_NO_WARNINGS=1 DS_AGENT_API_BASE=${DS_AGENT_API_BASE:-http://127.0.0.1:3425/v1} DS_AGENT_API_KEY=${DS_AGENT_API_KEY:-magpie} DS_AGENT_API_MODEL=${DS_AGENT_API_MODEL:-workbuddy/deepseek-v4.1-flash} vitest run",
    "test:live": "NODE_NO_WARNINGS=1 DS_AGENT_API_BASE=${DS_AGENT_API_BASE:-http://127.0.0.1:3425/v1} DS_AGENT_API_KEY=${DS_AGENT_API_KEY:-magpie} DS_AGENT_API_MODEL=${DS_AGENT_API_MODEL:-workbuddy/deepseek-v4.1-flash} vitest run test/live-demo.test.ts test/live-e2e.test.ts test/live-modules.test.ts",
    "test:demo:real": "NODE_NO_WARNINGS=1 DS_AGENT_REAL_CHANNELS=1 DS_AGENT_API_BASE=${DS_AGENT_API_BASE:-http://127.0.0.1:3425/v1} DS_AGENT_API_KEY=${DS_AGENT_API_KEY:-magpie} DS_AGENT_API_MODEL=${DS_AGENT_API_MODEL:-workbuddy/deepseek-v4.1-flash} vitest run test/demos-real-channels.test.ts",
    "test:coverage": "CI=true DS_AGENT_ALLOW_MOCK_FIXTURE=1 NODE_NO_WARNINGS=1 vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --exclude 'test/{live-demo,live-e2e,team-live,demos-real-channels}.test.ts'",
    "lint": "NODE_NO_WARNINGS=1 tsx scripts/lint.ts",
    "format:check": "if [ \"${DS_AGENT_FORMAT_BASE:-HEAD}\" = HEAD ]; then git diff --check HEAD; else git diff --check \"$DS_AGENT_FORMAT_BASE\" HEAD && git diff --check HEAD; fi",
    "ds-agent": "NODE_NO_WARNINGS=1 tsx src/cli/main.ts",
    "bench:bakeoff": "NODE_NO_WARNINGS=1 tsx src/cli/bakeoff.ts",
    "t48:smoke": "NODE_NO_WARNINGS=1 tsx scripts/t48-month-scale-protocol.ts",
    "typecheck": "tsc --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
